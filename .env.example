# Copy to .env and fill in. Never commit .env.

# Default LLM provider for every task (Google AI Studio key).
GEMINI_API_KEY=

# Optional providers, only needed if config/llm.json routes a task to them.
ANTHROPIC_API_KEY=
# OpenAI-compatible local server (e.g. Ollama). No key needed for Ollama.
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_API_KEY=

# Optional overrides of config/app.json
# CONCEPT_GRAPH_DIR=data/concept-graph-provisional
# DATABASE_PATH=data/progresso.db

# MCP server (apps/mcp, Phase 10). All optional.
# Shared access token: required as ?token=… or "Authorization: Bearer …" when set.
# Set it whenever the server is reachable from outside (a tunnel).
# PROGRESSO_MCP_TOKEN=
# MCP_PORT=3101
# MCP_LISTEN=127.0.0.1
# Extra Host headers accepted when no token is set (comma-separated)
# MCP_ALLOWED_HOSTS=
# Where the web app runs, for links from the widget
# PROGRESSO_WEB_URL=http://localhost:3100
# stdio only: bind the connection to one demo student
# PROGRESSO_STUDENT=demo-riya
