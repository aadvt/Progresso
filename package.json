{
  "name": "progresso",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "graph:validate": "pnpm --filter @progresso/core graph:validate",
    "analyse": "pnpm --filter @progresso/cli analyse",
    "llm:smoke": "pnpm --filter @progresso/llm smoke",
    "llm:usage": "pnpm --filter @progresso/llm usage",
    "db:generate": "pnpm --filter @progresso/db generate",
    "db:migrate": "pnpm --filter @progresso/db migrate",
    "db:seed": "pnpm --filter @progresso/db seed",
    "db:reset": "pnpm --filter @progresso/db reset",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm graph:validate",
    "web:dev": "pnpm --filter @progresso/web dev",
    "web:build": "pnpm --filter @progresso/web build",
    "web:start": "pnpm --filter @progresso/web start",
    "e2e": "pnpm --filter @progresso/web e2e",
    "questions:generate": "pnpm --filter @progresso/cli questions:generate",
    "simulate": "pnpm --filter @progresso/cli simulate",
    "lessons:generate": "pnpm --filter @progresso/cli lessons:generate",
    "videos:generate": "pnpm --filter @progresso/cli videos:generate",
    "videos:review": "pnpm --filter @progresso/cli videos:review",
    "mcp": "pnpm --filter @progresso/mcp start",
    "mcp:stdio": "pnpm --filter @progresso/mcp stdio",
    "mcp:build": "pnpm --filter @progresso/mcp build:ui",
    "mcp:smoke": "pnpm --filter @progresso/mcp smoke",
    "mcp:host-check": "pnpm --filter @progresso/mcp host-check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
